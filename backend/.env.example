# ==============================================================================
# NOVA Tech Backend Environment Variables Template (.env.example)
# SAFE FOR REPOSITORY & VERSION CONTROL - DO NOT PUT REAL SECRETS HERE
# ==============================================================================

# Core Django Settings
# In production (Render), generate a long random secret key and set DEBUG=False
SECRET_KEY=your-generate-a-secure-random-secret-key-for-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Database Configuration
# Local Development: Leave empty or use SQLite fallback
# Production (Render PostgreSQL): Set DATABASE_URL provided by Render Postgres (e.g. postgresql://user:pass@host:5432/dbname)
DATABASE_URL=sqlite:///db.sqlite3

# Cross-Origin (CORS) & CSRF Configuration
# Frontend origins allowed to make API calls to this backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app,https://your-backend.onrender.com

# Frontend Application URL (Used in email invitation links)
# Local: http://localhost:5173
# Production: Set to your deployed Vercel domain, e.g. https://your-frontend.vercel.app
FRONTEND_URL=http://localhost:5173

# Email Delivery Configuration (Configurable SMTP Settings)
# For Real Gmail SMTP delivery:
# 1. Enable 2-Step Verification on your Google Account
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Enter your Gmail address and 16-character App Password below (in Render Env Vars):
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your_personal_or_hr_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_character_app_password
DEFAULT_FROM_EMAIL="NOVA Tech Onboarding <your_personal_or_hr_email@gmail.com>"
EMAIL_TIMEOUT=10

# For local testing without sending real emails (prints email to console terminal):
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
