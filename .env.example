# NOVA Tech Frontend Environment Variables
# For Local Development:
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
# VITE_API_URL is also supported as an alias:
# VITE_API_URL=http://127.0.0.1:8000/api/v1

# Dual-Mode API Switch:
# Set to 'false' to connect to Django REST Framework backend (default for live system)
# Set to 'true' to use in-memory frontend mock store (offline demo mode only)
VITE_USE_MOCK_API=false

# In Vercel Project Settings -> Environment Variables:
# VITE_API_BASE_URL=https://<your-render-backend-app>.onrender.com/api/v1
# VITE_USE_MOCK_API=false
